{
  "compilerOptions": {
    "module": "amd",
    "target": "ES2022",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "ignoreDeprecations": "6.0",
    "removeComments": true,
    "sourceMap": false,
    "moduleResolution": "node",
    "baseUrl": ".",
    "esModuleInterop": true,
    "paths": {
      "@common/*": ["src/common/*"],
      "@toymvc/*": ["src/common/toymvc/*"]
    },
    "types": [
      "vitest",
      "node",
      "tampermonkey"
    ]
  },
  "exclude": [
    "node_modules",
    "build",
    "release",
     "**/*.spec.ts"
  ]
}
