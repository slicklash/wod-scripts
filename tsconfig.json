{
  "compilerOptions": {
    "module": "amd",
    "target": "es6",
    "noImplicitAny": false,
    "removeComments": true,
    "sourceMap": false,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/common/*"],
      "@toymvc/*": ["src/common/toymvc/*"]
    }
  },
  "exclude": [
    "node_modules",
    "build",
    "release",
     "**/*.spec.ts"
  ]
}
