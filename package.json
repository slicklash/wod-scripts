{
  "name": "wod-scripts",
  "version": "0.9.0",
  "description": "Collection of scripts for world-of-dungeons.net",
  "author": "slicklash@gmail.com",
  "license": "BSD-2-Clause",
  "scripts": {
    "re:favmenu": "tsc --project src/favorite_menu/tsconfig.json && node ./scripts/bundle.js favorite_menu && eslint ./release/favorite_menu.user.js",
    "re:hero": "tsc --project src/hero_list/tsconfig.json && node ./scripts/bundle.js hero_list && eslint ./release/hero_list.user.js",
    "re:num": "tsc --project src/numismatist/tsconfig.json && node ./scripts/bundle.js numismatist && eslint ./release/numismatist.user.js",
    "re:tidy": "tsc --project src/tidy_trade/tsconfig.json && node ./scripts/bundle.js tidy_trade && eslint ./release/tidy_trade.user.js",
    "re:storage": "tsc --project src/storage_management/tsconfig.json && node ./scripts/bundle.js storage_management && eslint ./release/storage_management.user.js",
    "re:adventure": "tsc --project src/adventure_assistant/tsconfig.json && node ./scripts/bundle.js adventure_assistant && eslint ./release/adventure_assistant.user.js",
    "re:profile": "tsc --project src/profile_export/tsconfig.json && node ./scripts/bundle.js profile_export && eslint ./release/profile_export.user.js",
    "re:itemizer": "tsc --project src/itemizer/tsconfig.json && node ./scripts/bundle.js itemizer && eslint ./release/itemizer.user.js",
    "build": "npm run re:favmenu && npm run re:hero && npm run re:num && npm run re:tidy && npm run re:storage && npm run re:adventure && npm run re:profile && npm run re:itemizer",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/tampermonkey": "^5.5.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^30.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^3.2.0"
  },
  "prettier": {
    "printWidth": 360
  }
}
